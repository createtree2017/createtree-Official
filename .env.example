NODE_ENV=production
PORT=3000

# Railway PostgreSQL
DATABASE_URL=
# require | disable
DATABASE_SSL=require

# Public site
PUBLIC_SITE_URL=https://your-railway-domain.up.railway.app
CORS_ORIGIN=https://your-railway-domain.up.railway.app

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_JWT_SECRET=change-this-long-random-secret

# Lead protection
LEAD_RATE_LIMIT_PER_HOUR=5

